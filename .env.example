# 複製為 .env 後填入。這裡只列程式實際會讀取的變數。

# ===== 必填 =====
# Discord 機器人 Token（Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=

# ===== 一般 =====
# 指令前綴
COMMAND_PREFIX=!
# 日誌級別：DEBUG / INFO / WARNING / ERROR（DEBUG 會記錄每則訊息內容）
LOG_LEVEL=INFO
# 單一日誌檔上限（bytes）與保留份數，logs/discord.log 會自動輪替
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# 爬取外部網站（股市、籤詩、星座運勢）的總逾時（秒）
HTTP_TIMEOUT=15

# ===== 快取 =====
# core/cache.py 的預設 TTL 與清理間隔（秒）
CACHE_TTL=3600
CACHE_CLEANUP_INTERVAL=3600
