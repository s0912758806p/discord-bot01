# Discord 機器人配置
TOKEN=your_bot_token_here  # Discord 機器人權杖
COMMAND_PREFIX=!  # 命令前綴，預設為 !

# 一般設置
LOG_LEVEL=INFO  # 日誌級別 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
RESTART_TIME=03:00  # 每日重啟時間 (24小時制)
NO_WEB_SERVER=false  # 設為 'true' 可禁用 Web 服務 (如果 Flask 有問題)

# 頻道設置
EARTHQUAKE_CHANNEL=123456789012345678  # 地震通知頻道ID

# API 設置
EARTHQUAKE_API_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore/E-A0016-001  # 中央氣象局地震API
EARTHQUAKE_API_KEY=your_cwb_api_key_here  # 中央氣象局API金鑰

# 地震監測設置
EARTHQUAKE_MAX_AGE_HOURS=24  # 最大處理地震年齡（小時）

# 緩存設置
CACHE_TTL=3600  # 預設緩存生存時間（秒）
CACHE_CLEANUP_INTERVAL=60  # 緩存清理間隔（秒）

# 兼容性提示
# 注意: 本機器人需要以下版本依賴:
# flask==2.0.1
# werkzeug==2.0.3 