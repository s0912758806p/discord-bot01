# 複製為 .env 後填入。這裡只列程式實際會讀取的變數。

# ===== 必填 =====
# Discord 機器人 Token（Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=

# ===== 一般 =====
# 指令前綴
COMMAND_PREFIX=!
# 日誌級別：DEBUG / INFO / WARNING / ERROR（DEBUG 會記錄每則訊息內容）
LOG_LEVEL=INFO
# 單一日誌檔上限（bytes）與保留份數，logs/discord.log 會自動輪替
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# 爬取外部網站（股市、新聞、籤詩、星座運勢）的總逾時（秒）
HTTP_TIMEOUT=15

# ===== 台股通知 =====
# 接收早盤報告與盤中波動通知的頻道 ID，可用逗號分隔多個；留空則不啟動（!twii 等指令仍可用）
STOCK_CHANNEL=
# 早盤報告的發送時間（台北時間 HH:MM，只在交易日發送）
STOCK_REPORT_TIME=08:30
# 早盤報告中國內、國際新聞各列幾則
STOCK_NEWS_LIMIT=8
# 盤中（交易日 09:00–13:35）抓加權指數的間隔（秒）
STOCK_POLL_SECONDS=30
# 漲跌幅（相對昨收）首次突破此值的每個倍數時通知，例如 1 → ±1%、±2%、±3%…
STOCK_ALERT_STEP_PCT=1
# 短時間急漲急跌：STOCK_RAPID_WINDOW_MIN 分鐘內變動達 STOCK_RAPID_PCT% 就通知
STOCK_RAPID_PCT=0.7
STOCK_RAPID_WINDOW_MIN=5
# 同方向急漲急跌通知的冷卻時間（分鐘）
STOCK_RAPID_COOLDOWN_MIN=15

# ===== 快取 =====
# core/cache.py 的預設 TTL 與清理間隔（秒）
CACHE_TTL=3600
CACHE_CLEANUP_INTERVAL=3600
