# Discord Bot Token
TOKEN=your_discord_bot_token_here

# 日誌級別 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 機器人前綴
COMMAND_PREFIX=/

# 地震監測模組設定
EARTHQUAKE_CHANNEL=channel_id_here  # 地震頻道ID
EARTHQUAKE_API_KEY=your_cwb_api_key_here  # 中央氣象局地震API金鑰
EARTHQUAKE_API_URL=https://opendata.cwb.gov.tw/api/v1/rest/datastore/E-A0016-001  # 中央氣象局地震API URL
EARTHQUAKE_MAX_AGE_HOURS=24  # 只處理多少小時內的地震 (預設24小時)

# 緩存設定
CACHE_TTL=3600  # 默認緩存時間 (秒)
CACHE_CLEANUP_INTERVAL=3600  # 緩存清理間隔 (秒)

# 定時任務設定
RESTART_TIME=03:00  # 每日重啟時間 (24小時制) 