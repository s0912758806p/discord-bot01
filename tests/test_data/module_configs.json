{
  "module_connector": {
    "enabled": true,
    "log_level": "INFO",
    "connection_timeout": 30,
    "retry_attempts": 3,
    "retry_delay": 5
  },
  "discord_bot": {
    "log_level": "INFO",
    "command_prefix": "!",
    "description": "Discord Bot for Testing",
    "intents": ["guilds", "guild_messages", "message_content"],
    "connection_retry": {
      "max_attempts": 5,
      "backoff_factor": 1.5,
      "initial_delay": 2
    },
    "vm_environment": {
      "startup_delay": 30,
      "health_check_interval": 600
    }
  }
}
