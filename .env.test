# Discord 機器人設置
DISCORD_TOKEN=TEST_TOKEN_1234567890
PREFIX=!
DISCORD_HTTP_TIMEOUT=90

# 地震模組設置
EARTHQUAKE_API_KEY=TEST_API_KEY_1234567890
EARTHQUAKE_INIT_TIMEOUT=120
EARTHQUAKE_RETRY_INTERVAL=5
EARTHQUAKE_MAX_RETRIES=10
EARTHQUAKE_INITIAL_DELAY=10
VM_ENVIRONMENT=false

# 日誌設置
LOG_LEVEL=INFO

# 測試環境設置
TEST_MODE=true
SKIP_API_CALLS=true 